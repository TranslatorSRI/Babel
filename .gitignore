# The private input files directory is for files that should not be included in
# Git or Docker, such as UMLS files.
input_files/private

# Python build/packaging artifacts (from the GitHub Python .gitignore).
__pycache__/
*.py[cod]
*.egg
*.egg-info/
.eggs/
build/
dist/
.venv/
.pytest_cache/
babel_downloads/
babel_outputs/
.snakemake/
.env
.idea
htmlcov/

# Full source-impact detail tables: always generated locally for digging and for sharing with an
# SME, never committed. Each grows roughly linearly with the source (for EMAPA: 1.2 MB of
# modified-cliques, 464 KB of xrefs, 388 KB of new cliques) and goes stale on the next build, so
# committing them adds megabytes nobody reads. What *is* committed is the two reductions the tool
# writes beside them — new-cliques-top-100.csv and new-xrefs-summary.csv — which is why this list
# is a fixed rule rather than the old "commit it when it happens to be small" judgement call.
# To share a full table, re-run the tool and upload it; see docs/AddingNewSources.md.
docs/sources/*/impact-report/modified-cliques.json
docs/sources/*/impact-report/modified-cliques.csv
docs/sources/*/impact-report/new-cliques.csv
docs/sources/*/impact-report/new-xrefs.csv

# Local scratch space for ad hoc files (analysis notebooks, one-off downloads, intermediates).
# Anchored to the repo root: unanchored, this also swallowed tests/data/, so every committed test
# fixture there had to be force-added. The one tracked file, data/.gitkeep, was force-added so every
# checkout has the directory; how to use it is in AGENTS.md ("Scratch space").
/data/

# Build metadata regenerated by `uv sync` / setuptools; never committed.
*.egg-info/

# macOS Finder metadata, which turns up in any directory browsed in Finder.
.DS_Store

# Coverage data written by `pytest --cov`.
.coverage
.coverage.*
htmlcov/

# Spreadsheet sources for the hand-curated manual concords. The .tsv the pipeline reads is
# committed; the Numbers/Excel file it was exported from is a 170 KB binary that diffs as a blob
# and is only useful on the maintainer's machine.
*.numbers
*.xlsx

# macOS Finder metadata.
.DS_Store

# Jupyter autosaves
.ipynb_checkpoints/

# Compiled Rust extension modules built into src/ by maturin (see PR #975). Build output, not
# source: the .so is platform- and Python-ABI-specific, so committing one breaks every other
# machine that imports it.
src/*.so
